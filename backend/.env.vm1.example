# ─────────────────────────────────────────────────────────────────────────────
# VM1 environment — copy to .env on VM1 before running docker-compose.vm1.yml
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Sales Intelligence Agent"
APP_ENV=production
DEBUG=false

# ── Cross-VM networking ───────────────────────────────────────────────────────
# The private/internal IP of VM3 (Qdrant + MinIO + Nginx).
# Used by the FastAPI app container to reach vector DB and object storage.
VM3_INTERNAL_IP=10.0.0.3

# ── PostgreSQL 17 (running on VM1) ───────────────────────────────────────────
POSTGRES_USER=betopia
POSTGRES_PASSWORD=change_me_strong_password_here
POSTGRES_DB=sales_agent
# Host bind for cross-VM access: use VM1's private IP to restrict to private subnet
# (combined with OS firewall rules)
POSTGRES_HOST_BIND=0.0.0.0

# ── Redis 7.4 (running on VM1) ────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password_here
REDIS_MAX_MEMORY=1gb
REDIS_URL=redis://:change_me_redis_password_here@redis:6379/0
REDIS_SUGGESTION_CACHE_TTL=300
REDIS_EMBEDDING_CACHE_TTL=86400
# Host bind for cross-VM access
REDIS_HOST_BIND=0.0.0.0

# ── NATS (running on VM1) ─────────────────────────────────────────────────────
NATS_URL=nats://nats:4222
NATS_STREAM_NAME=sales_agent
NATS_SUBJECT_PREFIX=betopia.sales
NATS_HOST_BIND=0.0.0.0

# ── Qdrant (on VM3 — accessed by FastAPI over private network) ────────────────
QDRANT_HOST=10.0.0.3
QDRANT_PORT=6333
QDRANT_API_KEY=change_me_qdrant_api_key_here
QDRANT_COLLECTION_CONVERSATIONS=conversations
QDRANT_COLLECTION_REQUIREMENTS=requirements
QDRANT_COLLECTION_PRICING=pricing
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=200

# ── MinIO (on VM3 — accessed by FastAPI over private network) ─────────────────
MINIO_ENDPOINT=10.0.0.3:9000
MINIO_ACCESS_KEY=change_me_minio_access_key
MINIO_SECRET_KEY=change_me_minio_secret_key
MINIO_SECURE=false
MINIO_BUCKET_PROPOSALS=proposals
MINIO_BUCKET_QUOTATIONS=quotations
MINIO_BUCKET_REQUIREMENTS=requirements

# ── LLM — OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_PRIMARY_MODEL=gpt-4.1
LLM_MINI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072

# ── LLM — Anthropic (fallback) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_FALLBACK_MODEL=claude-sonnet-4-6
LLM_PRIMARY_TIMEOUT=3.0
LLM_FALLBACK_TIMEOUT=8.0

# ── vLLM (intent + tone — optional, leave empty to use GPT-4.1-mini instead) ──
VLLM_BASE_URL=
VLLM_MODEL=mistral-7b-instruct

# ── JWT — RS256 ───────────────────────────────────────────────────────────────
# Generate: make certs
JWT_RS256_PRIVATE_KEY_PATH=/app/certs/private.pem
JWT_RS256_PUBLIC_KEY_PATH=/app/certs/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Fiverr (profile ID only — no webhook) ─────────────────────────────────────
FIVERR_PROFILE_ID=your_fiverr_username_here

# ── Odoo ERP (future) ─────────────────────────────────────────────────────────
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# ── Document storage (MinIO takes priority; these are fallback temp paths) ────
DOC_OUTPUT_DIR=/tmp/quotations
PROPOSAL_OUTPUT_DIR=/tmp/proposals
PROMPTS_DIR=/app/prompts

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password
