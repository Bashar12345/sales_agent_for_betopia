# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Sales Intelligence Agent"
APP_ENV=development          # development | staging | production
DEBUG=true

# ── PostgreSQL 17 ─────────────────────────────────────────────────────────────
# Direct connection (asyncpg) — app connects via PgBouncer in production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=betopia
POSTGRES_PASSWORD=betopia_secret
POSTGRES_DB=sales_agent

# PgBouncer pooled connection (production override)
# PGBOUNCER_HOST=pgbouncer
# PGBOUNCER_PORT=6432

# ── Qdrant Vector DB ──────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                        # leave empty for local dev; set for cloud
# Collection names (HNSW-indexed, auto-created on startup)
QDRANT_COLLECTION_CONVERSATIONS=conversations
QDRANT_COLLECTION_REQUIREMENTS=requirements
QDRANT_COLLECTION_PRICING=pricing

# ── LLM — Primary (OpenAI) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_PRIMARY_MODEL=gpt-4.1             # P1 suggestion generation + P2 Vision
LLM_MINI_MODEL=gpt-4.1-mini           # Simple classification tasks
# Embedding: 3072-dimensional vectors
EMBEDDING_MODEL=text-embedding-3-large

# ── LLM — Fallback (Anthropic Claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
LLM_FALLBACK_MODEL=claude-sonnet-4-6  # Fallback when GPT-4.1 >3s or fails

# ── LLM — In-house vLLM ───────────────────────────────────────────────────────
# Intent classification + tone validation (low-cost, ~$0 per request)
VLLM_BASE_URL=http://localhost:11434   # Ollama default port
VLLM_MODEL=mistral                    # ollama pull mistral
VLLM_TIMEOUT=60.0                     # CPU inference can take 10-30s; 60s is safe

# ── Fiverr ────────────────────────────────────────────────────────────────────
# Profile ID only — NO webhook. Salesperson manually pastes messages.
FIVERR_PROFILE_ID=your_fiverr_profile_id

# ── JWT — RS256 Asymmetric ────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048
#                openssl rsa -in private.pem -pubout -out public.pem
JWT_RS256_PRIVATE_KEY_PATH=./certs/private.pem
JWT_RS256_PUBLIC_KEY_PATH=./certs/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Odoo ERP Integration (future) ─────────────────────────────────────────────
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=odoo_db_name
ODOO_USERNAME=admin
ODOO_API_KEY=odoo_api_key_here

# ── Redis 7.4+ (Celery broker + suggestion cache + embedding cache) ────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SUGGESTION_CACHE_TTL=300        # 5 minutes
REDIS_EMBEDDING_CACHE_TTL=86400       # 24 hours

# ── NATS JetStream (event bus) ────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=sales_agent
NATS_SUBJECT_PREFIX=betopia.sales

# ── Document Generation ───────────────────────────────────────────────────────
DOC_OUTPUT_DIR=/tmp/quotations
PROPOSAL_OUTPUT_DIR=/tmp/proposals
